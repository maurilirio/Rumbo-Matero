# ─────────────────────────────────────────────────────────────
# Variables de entorno — Rumbo Matero (formulario de reserva)
#
# Copiá este archivo como ".env" y completá los valores reales.
# NUNCA subas el ".env" al repo (ya está ignorado en .gitignore).
# En Vercel se cargan en: Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# (Obligatoria) Mail donde querés RECIBIR las solicitudes de reserva.
OWNER_EMAIL=

# (Opcional) Proveedor de envío de mail: "nitrosend" (default) o "resend".
EMAIL_PROVIDER=nitrosend

# (Obligatoria si usás Nitrosend) API key de Nitrosend.
# Se genera en: Nitrosend → Settings → API Keys  (empieza con nskey_live_...)
NITROSEND_API_KEY=

# (Obligatoria si usás Resend) API key de Resend.
RESEND_API_KEY=

# (Opcional) Remitente del mail. Si lo dejás vacío se usa el sender
# verificado del proveedor. Debe ser de un dominio verificado.
FROM_EMAIL=
